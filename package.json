{
  "name": "hyper-learn",
  "version": "1.0.0",
  "description": "HyperLearn — adaptive learning backend on a self-correcting hypergraph (LangGraph multi-agent).",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "eval": "tsx src/eval/run.ts",
    "loop": "tsx src/cli/loop.ts",
    "bundle": "tsx src/cli/build-bundle.ts",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build:web": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "wrangler types worker/worker-configuration.d.ts > /dev/null && tsc --noEmit && tsc -p worker && tsc -p web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radeshgovind-2005/hyper-learn.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/radeshgovind-2005/hyper-learn/issues"
  },
  "homepage": "https://github.com/radeshgovind-2005/hyper-learn#readme",
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/react": "^6.18.3",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/openai": "^1.8.0",
    "agents": "^0.31.0",
    "dotenv": "^18.0.9",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
