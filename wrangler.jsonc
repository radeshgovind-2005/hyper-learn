{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperlearn",
  "account_id": "880ce52eda03556a28c57b3488f3517b",
  "main": "worker/index.ts",
  // Served at this domain; the radesh-govind.com zone must be in the same Cloudflare account.
  "routes": [{ "pattern": "hyperlearn.radesh-govind.com", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The UI, built by `npm run build:web` (Vite) into web/dist.
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CourseAgent", "class_name": "CourseAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CourseAgent"] }],
  // Workers AI: Llama Guard (safety) and bge embeddings (paraphrase checks). Optional at runtime.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard (e.g. LANGSMITH_TRACING, LANGSMITH_PROJECT) across deploys;
  // without this, every CI deploy would replace them with only the vars below.
  "keep_vars": true,
  "vars": {
    // Point MODEL_BASE_URL at an AI Gateway to log every model call. Set MODEL_API_KEY as a secret:
    //   npx wrangler secret put MODEL_API_KEY      (locally: .dev.vars)
    // Set ADMIN_TOKEN the same way before deploying: without it, anyone can reset the course and approve releases.
    // LangSmith tracing (optional, off by default): set LANGSMITH_API_KEY as a secret, and
    // LANGSMITH_TRACING=true and LANGSMITH_PROJECT here or as secrets.
    // Without a key, runs use the reference stand-ins and make no model calls.
    "MODEL_BASE_URL": "",
    "REASONING_MODEL": "muse-spark-1.3",
    "FAST_MODEL": "muse-spark-1.3",
    "STRUCTURED_OUTPUT_METHOD": "jsonSchema",
    "MODEL_TIMEOUT_MS": "120000",
    "MODEL_MAX_RETRIES": "1"
  }
}
