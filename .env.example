# ─── Model provider ────────────────────────────────────────────────
# Local llama.cpp / LM Studio (OpenAI-compatible) server
MODEL_BASE_URL=http://localhost:9931/v1
MODEL_API_KEY=not-needed-locally

# Model used by the Curator + Reflection (structured output, reasoning)
REASONING_MODEL=meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M
# Model used by the Learner Assistant (tool calling, low latency)
FAST_MODEL=meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M

# How structured output is requested: jsonSchema | functionCalling | jsonMode
# (switch to functionCalling if your local server rejects response_format)
STRUCTURED_OUTPUT_METHOD=jsonSchema

# Per-call timeout and retries. A call that exceeds the timeout fails with an error
# instead of hanging. LangChain retries 6 times by default; keep this low for a slow local model.
MODEL_TIMEOUT_MS=600000
MODEL_MAX_RETRIES=1

# ─── Meta Model API (swap in when ready) ───────────────────────────
# MODEL_BASE_URL=<Meta Model API OpenAI-compatible base URL>
# MODEL_API_KEY=<your Meta API key>
# REASONING_MODEL=muse-spark-1.3
# FAST_MODEL=muse-spark-1.3
